DATABASE_URL="postgresql://hammer:hammer@postgres:5432/hammer_os?schema=public"
# Local dev defaults to demo data even when DATABASE_URL is present.
# Set to "database" to test Postgres locally, or "demo" to force demo/local data.
GREENLIGHT_DATA_MODE=""
GCS_BUCKET_NAME=""
GCS_PROJECT_ID=""
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-session-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
# Optional Google sign-in allowlist. Existing GreenLight users can always sign in.
# New Google users are created only when their email/domain is listed here.
GOOGLE_ALLOWED_DOMAINS="hammerstudiosinc.com"
GOOGLE_ALLOWED_EMAILS=""
ADMIN_EMAIL="admin@greenlight.local"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
UPLOAD_STORAGE_DRIVER="gcs"
GCS_UPLOAD_BUCKET=""
UPLOAD_DIR="./uploads"
# Scanned/image-only PDF fallback. Keep inline OCR bounded so large scanned PDFs upload with a warning instead of timing out.
OCR_INLINE_ENABLED="true"
OCR_MAX_INLINE_BYTES="36700160"
OCR_MAX_PAGES="60"
OCR_DPI="160"
OCR_RENDER_TIMEOUT_MS="120000"
OCR_PAGE_TIMEOUT_MS="45000"
# LLM providers. Set LLM_SECRET_KEY to at least 32 characters to allow encrypted API key entry in Admin Settings.
LLM_SECRET_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GREENLIGHT_LLM_PROVIDER="anthropic"
GREENLIGHT_LLM_MODEL="claude-sonnet-5"
# Airtable Prospects sync. Keep the token server-side only.
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID="appKCINmEMPpqkwqt"
# Actual Airtable tables that become GreenLight Prospects tabs.
AIRTABLE_SYNC_TABLES="Projects,Cultural Trends,Public IP"
# If table names fail, use exact Airtable table IDs while keeping friendly GreenLight tab labels.
# AIRTABLE_SYNC_TABLES="Projects=tblXXXXXXXXXXXXXX,Cultural Trends=tblYYYYYYYYYYYYYY,Public IP=tblZZZZZZZZZZZZZZ"
# Optional only if a future Airtable setup uses one source table with multiple views.
# AIRTABLE_SOURCE_TABLE="tblXXXXXXXXXXXXXX"
# AIRTABLE_SYNC_VIEWS="Projects=viwXXXXXXXXXXXXXX,Public IP=viwYYYYYYYYYYYYYY,Cultural Trends=viwZZZZZZZZZZZZZZ"
AIRTABLE_SYNC_SECRET=""
