DATABASE_URL="postgresql://hammer:hammer@postgres:5432/hammer_os?schema=public"
# Local dev defaults to demo data even when DATABASE_URL is present.
# Set to "database" to test Postgres locally, or "demo" to force demo/local data.
GREENLIGHT_DATA_MODE=""
GCS_BUCKET_NAME=""
GCS_PROJECT_ID=""
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-session-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
# Optional Google sign-in allowlist. Existing GreenLight users can always sign in.
# New Google users are created only when their email/domain is listed here.
GOOGLE_ALLOWED_DOMAINS="hammerstudiosinc.com"
GOOGLE_ALLOWED_EMAILS=""
ADMIN_EMAIL="admin@greenlight.local"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
UPLOAD_STORAGE_DRIVER="gcs"
GCS_UPLOAD_BUCKET=""
UPLOAD_DIR="./uploads"
# Scanned/image-only PDF fallback. Keep inline OCR bounded so large scanned PDFs upload with a warning instead of timing out.
OCR_INLINE_ENABLED="true"
OCR_MAX_INLINE_BYTES="36700160"
OCR_MAX_PAGES="60"
OCR_DPI="160"
OCR_RENDER_TIMEOUT_MS="120000"
OCR_PAGE_TIMEOUT_MS="45000"
# LLM providers. Keep API keys in the server environment; do not store them in the database.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GREENLIGHT_LLM_PROVIDER="anthropic"
GREENLIGHT_LLM_MODEL="claude-sonnet-5"
